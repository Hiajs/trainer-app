{
  "name": "searchgpt-x",
  "productName": "SearchGPT X",
  "version": "1.0.0",
  "description": "An AI-powered desktop browser with conversational search, citations and a built-in assistant.",
  "main": "dist/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "test:e2e": "npm run build && node scripts/e2e.mjs out/e2e",
    "icon": "node scripts/make-icon.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs arm64",
    "package:mac-intel": "npm run build && node scripts/package-mac.mjs x64"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "electron": "^35.7.5",
    "esbuild": "^0.28.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.76.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
